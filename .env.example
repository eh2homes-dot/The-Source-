# Copy to .env and fill in. NEVER commit the real .env (it's git-ignored).
#
# Used by the AI résumé-screening proxy (api/screen.js) during local `npm run dev`.
# In production (Vercel), set ANTHROPIC_API_KEY as a project Environment Variable
# instead — do not ship it in the build.
#
# Get a key at: https://console.anthropic.com  → API Keys
ANTHROPIC_API_KEY=sk-ant-...
